[flake8]
# تنظیم طول خط استاندارد هماهنگ با Black
max-line-length = 88

# استثنا کردن پوشه‌ها و فایل‌های خاص
exclude =
    .git,
    .gitignore,
    *.pot,
    *.py[co],
    __pycache__,
    venv,
    .venv,
    .env,
    migrations,
    settings.py,
    core/settings.py

# نادیده گرفتن خطاهای ناسازگار با Black و نادیده گرفتن import * (F403)
extend-ignore = 
    E203,
    W503,
    F403,

# عدم گرفتن خطای Unused Import برای فایل‌های __init__.py
per-file-ignores =
    __init__.py: F401